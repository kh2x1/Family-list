# ====================================================================
# متغيرات البيئة الخاصة بـ Supabase
# انسخ هذا الملف إلى ‎.env‎ ثم املأ القيم من لوحة تحكم Supabase
# Project Settings → API
# ====================================================================

# رابط مشروع Supabase (مثال: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# المفتاح العام (anon / public key) — آمن للاستخدام في الواجهة الأمامية
VITE_SUPABASE_ANON_KEY=your-anon-public-key
